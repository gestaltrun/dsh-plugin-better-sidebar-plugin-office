{
  "name": "@gestaltrun/dsh-sidebar-office",
  "version": "0.1.3-gestaltrun.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "candidate"
  },
  "keywords": [
    "dsh-plugin"
  ],
  "description": "Read-only DOCX, XLSX, and PPTX viewers for the Gestaltrun DSH sidebar.",
  "type": "module",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gestaltrun/dsh-plugin-better-sidebar-plugin-office"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "!lib/*.map",
    "src/",
    "tsconfig.json",
    "tsconfig.build.json",
    "tsdown.config.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@gestaltrun/dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown --config tsdown.config.ts && tsc -p tsconfig.build.json",
    "bundle:client": "tsdown --config tsdown.config.ts",
    "watch": "tsdown --config tsdown.config.ts --watch",
    "release:pack": "node scripts/release-package.mjs pack",
    "release:publish": "node scripts/release-package.mjs publish",
    "prepublishOnly": "node scripts/release-package.mjs guard",
    "test:release": "node --test tests/release-package.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@gestaltrun/dsh-better-sidebar": "0.19.1-gestaltrun.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@gestaltrun/dsh-better-sidebar": "0.19.1-gestaltrun.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "docx-preview": "^0.4.0",
    "fflate": "0.8.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
